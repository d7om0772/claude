{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Skill",
      "Agent",
      "Task",
      "ToolSearch",
      "NotebookEdit",
      "mcp__ElevenLabs",
      "mcp__schedulin",
      "mcp__Cloudinary",
      "mcp__tiktok_scraper",
      "mcp__pexels"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard origin/main~:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "1200000",
    "PYTHONDONTWRITEBYTECODE": "1"
  }
}
